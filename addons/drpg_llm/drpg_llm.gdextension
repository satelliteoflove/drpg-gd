[configuration]
entry_symbol = "drpg_llm_init"
compatibility_minimum = "4.5"

[libraries]
macos.debug = "res://addons/drpg_llm/bin/libdrpg_llm.macos.template_debug.universal.dylib"
macos.release = "res://addons/drpg_llm/bin/libdrpg_llm.macos.template_release.universal.dylib"
windows.debug.x86_64 = "res://addons/drpg_llm/bin/drpg_llm.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/drpg_llm/bin/drpg_llm.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/drpg_llm/bin/libdrpg_llm.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/drpg_llm/bin/libdrpg_llm.linux.template_release.x86_64.so"

